{
 "datasets": [
  {
   "name": "ds_runtime",
   "displayName": "Compute runtime (estimate)",
   "queryLines": [
    "SELECT usage_date, env, component, data_country, kind, workload, compute_minutes, est_cost_usd\n",
    "FROM pos_global.finops.runtime_daily WHERE usage_date >= date_sub(current_date(), 30)\n"
   ]
  },
  {
   "name": "ds_billing",
   "displayName": "Billed usage (system.billing.usage)",
   "queryLines": [
    "SELECT usage_date, env, component, data_country, product, workload, dbus, list_cost_usd\n",
    "FROM pos_global.finops.billing_daily WHERE usage_date >= date_sub(current_date(), 30)\n"
   ]
  },
  {
   "name": "ds_tags",
   "displayName": "Tag coverage",
   "queryLines": [
    "SELECT usage_date, untagged_pct FROM pos_global.finops.tag_coverage\n"
   ]
  }
 ],
 "pages": [
  {
   "name": "finops",
   "displayName": "FinOps",
   "pageType": "PAGE_TYPE_CANVAS",
   "layoutVersion": "GRID_V1",
   "layout": [
    {
     "widget": {
      "name": "title",
      "multilineTextboxSpec": {
       "lines": [
        "## FinOps: spend by environment, tag and pipeline\n"
       ]
      }
     },
     "position": {
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 1
     }
    },
    {
     "widget": {
      "name": "subtitle",
      "multilineTextboxSpec": {
       "lines": [
        "Budgets **alert**; policies and quotas **enforce** (serverless budget policy tags, cluster policy caps, warehouse max clusters, job max_concurrent_runs). Billed cost comes from `system.billing.usage`; this Free Edition workspace emits no billable usage, so the runtime-based **estimate** (compute minutes x USD 0.10) is shown next to it.\n"
       ]
      }
     },
     "position": {
      "x": 0,
      "y": 1,
      "width": 12,
      "height": 2
     }
    },
    {
     "widget": {
      "name": "filter_env",
      "queries": [
       {
        "name": "ds_runtime_env",
        "query": {
         "datasetName": "ds_runtime",
         "fields": [
          {
           "name": "env",
           "expression": "`env`"
          }
         ],
         "disaggregated": false
        }
       },
       {
        "name": "ds_billing_env",
        "query": {
         "datasetName": "ds_billing",
         "fields": [
          {
           "name": "env",
           "expression": "`env`"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "filter-multi-select",
       "encodings": {
        "fields": [
         {
          "fieldName": "env",
          "displayName": "Environment",
          "queryName": "ds_runtime_env"
         },
         {
          "fieldName": "env",
          "displayName": "Environment",
          "queryName": "ds_billing_env"
         }
        ]
       },
       "frame": {
        "showTitle": true,
        "title": "Environment"
       }
      }
     },
     "position": {
      "x": 0,
      "y": 3,
      "width": 12,
      "height": 2
     }
    },
    {
     "widget": {
      "name": "kpi_est",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "ds_runtime",
         "fields": [
          {
           "name": "sum(est_cost_usd)",
           "expression": "SUM(`est_cost_usd`)"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "counter",
       "encodings": {
        "value": {
         "fieldName": "sum(est_cost_usd)",
         "displayName": "Estimated cost, 30 days (USD)",
         "format": {
          "type": "number-currency",
          "currencyCode": "USD",
          "abbreviation": "compact",
          "decimalPlaces": {
           "type": "max",
           "places": 1
          }
         }
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Estimated cost, 30 days (USD)"
       }
      }
     },
     "position": {
      "x": 0,
      "y": 5,
      "width": 4,
      "height": 3
     }
    },
    {
