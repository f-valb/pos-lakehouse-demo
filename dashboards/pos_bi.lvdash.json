{
 "datasets": [
  {
   "name": "ds_freshness",
   "displayName": "Freshness",
   "queryLines": [
    "SELECT country, data_as_of, latest_sale_utc,\n",
    "  round((unix_timestamp(current_timestamp()) - unix_timestamp(data_as_of)) / 60, 1) AS minutes_behind,\n",
    "  CASE WHEN (unix_timestamp(current_timestamp()) - unix_timestamp(data_as_of)) / 60 <= 15 THEN 'FRESH' ELSE 'STALE' END AS status\n",
    "FROM data_as_of\n"
   ]
  },
  {
   "name": "ds_sales_hourly",
   "displayName": "Sales by country and hour",
   "queryLines": [
    "SELECT country, txn_hour_utc, sum(net_sales_usd) AS net_sales_usd, sum(transactions) AS transactions, sum(units) AS units\n",
    "FROM sales_by_country_hour\n",
    "WHERE txn_hour_utc >= timestampadd(HOUR, -48, current_timestamp())\n",
    "GROUP BY country, txn_hour_utc\n"
   ]
  },
  {
   "name": "ds_forecast",
   "displayName": "Forecast vs actual",
   "queryLines": [
    "SELECT country, business_date, series, units FROM bi_forecast_vs_actual\n",
    "WHERE business_date >= date_sub(current_date(), 30)\n"
   ]
  },
  {
   "name": "ds_churn",
   "displayName": "Churn risk",
   "queryLines": [
    "SELECT country, as_of_date, risk_band, model_version, customers, avg_score FROM bi_churn_risk\n"
   ]
  },
  {
   "name": "ds_latency",
   "displayName": "Latency per stage",
   "queryLines": [
    "SELECT country, records, poll_p50, poll_p95, bronze_p50, silver_p50, gold_p50, end_to_end_p50, end_to_end_p95, measured_at\n",
    "FROM pipeline_latency ORDER BY country\n"
   ]
  }
 ],
