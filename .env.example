# Copy to .env and adjust. Never commit real secrets.
# Databricks auth comes from ~/.databrickscfg (DEFAULT profile, OAuth U2M) - no token in this file.
DATABRICKS_CONFIG_PROFILE=DEFAULT
DEMO_ENV=dev                       # dev | staging | prod -> UC schema prefix

# Mock legacy API
POS_API_URL=http://127.0.0.1:8080
POS_API_RECORDS_PER_MINUTE=50000   # total across all regions

# Local AWS (LocalStack). Dummy creds are what LocalStack expects.
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-southeast-1

# Poller sinks: s3 (LocalStack) and/or volume (Databricks UC Volume via Files API)
POLLER_SINKS=s3,volume
